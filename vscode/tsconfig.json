{
  // Type checking only: scripts/build.mjs bundles the extension and its
  // tests with rolldown, which resolves the workspace's packages as node
  // does (the engine's native entry is exported under "node").
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["node"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
