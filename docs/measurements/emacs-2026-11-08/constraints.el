;;; constraints.el --- C-c C-= (agda2-show-constraints nil) after a load, in batch
;; FILE is the last command-line argument; CONFIG_UNDER_TEST is loaded first.
(require 'subr-x)
(add-to-list 'load-path (car (file-expand-wildcards (expand-file-name "~/.config/emacs/.local/straight/build-*/agda2-mode"))))
(require 'agda2-mode)
(load (expand-file-name (getenv "CONFIG_UNDER_TEST")) nil t)
(defun c/wait (re timeout)
  (let ((t0 (float-time)) seen)
    (while (and (not seen) (< (- (float-time) t0) timeout))
      (setq seen (with-current-buffer (get-buffer-create "*agda2*")
                   (save-excursion (goto-char (point-min)) (re-search-forward re nil t))))
      (unless seen (accept-process-output nil 0.5)))
    seen))
(let ((file (car (last command-line-args-left))))
  (setq command-line-args-left nil)
  (with-current-buffer (find-file-noselect file)
    (unless (eq major-mode 'agda2-mode) (agda2-mode))
    (while (accept-process-output nil 2))
    (with-current-buffer "*agda2*" (erase-buffer))
    (agda2-load)
    (message "load: %s" (if (c/wait "\\*All Done\\*\\|\\*Error\\*" 600) "verdict" "none"))
    (while (accept-process-output nil 2))
    (with-current-buffer "*agda2*" (erase-buffer))
    (message "agda version reported: %s; agda2-mode's own: 2.9.0 (straight build)" (plist-get agda-for-project--last :version))
    (condition-case err (agda2-show-constraints nil) (error (message "show-constraints signalled: %S" err)))
    (c/wait "agda2-info-action\\|cannot read\\|rror" 60)
    (while (accept-process-output nil 2))
    (message "sent: %s" (with-current-buffer "*agda2*" (save-excursion (goto-char (point-min)) (buffer-substring (point-min) (line-end-position)))))
    (message "*agda2* after C-c C-=:\n%s" (with-current-buffer "*agda2*" (string-trim (buffer-substring-no-properties (point-min) (min (point-max) 1200)))))))
(ignore-errors (agda2-term))
