# File: stdlib/patches/0001-eta-equality-is-no-longer-inferred.patch
#
# What: agda/agda-stdlib commit 1896499fc394265ba199a28309844d8cc2333759
# (branch agda-master, Andreas Abel, 2026-04-23), cherry-picked onto v2.3
# without change: Data.Record gains an ETA_EQUALITY pragma, and
# Reflection.AST.Traversal declares no-eta-equality, which Agda 2.9.0 no
# longer infers (agda/agda#8533).
#
# Why: the standard library 2.3, which agda-algebras depends on, checks
# under Agda 2.9.0 with these three patches and with no released version
# (issue 61, row 2b); the page ships it so patched (issue 58).
#
# Against: agda/agda-stdlib v2.3 (8326c7475af1fa456ca04a0203c168d5d7ff842b),
# applied in order by the flake (packages.stdlib).
#
From 0297f4a70c54f3547b3f2ad72c073fe6c91eea58 Mon Sep 17 00:00:00 2001
From: Andreas Abel <andreas.abel@ifi.lmu.de>
Date: Thu, 23 Apr 2026 19:21:01 +0200
Subject: [PATCH 1/3] Fixes for agda/agda#8533: eta equality is no longer
 inferred

- `Data.Record` needs a `ETA_EQUALITY` pragma to suppress the `UnguardedEtaRecord` warning.
- `Reflection.AST.Traversal` needs an explicit declaration of `no-eta-equality`.
  This was previously inferred.
---
 src/Data/Record.agda              | 2 ++
 src/Reflection/AST/Traversal.agda | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/Data/Record.agda b/src/Data/Record.agda
index 709ce69a6..8a9c6d5f3 100644
--- a/src/Data/Record.agda
+++ b/src/Data/Record.agda
@@ -62,6 +62,8 @@ mutual
   -- Record is a record type to ensure that the signature can be
   -- inferred from a value of type Record Sig.
 
+  {-# ETA_EQUALITY #-}  -- Suppress warning UnguardedEtaRecord
+
   record Record {s} (Sig : Signature s) : Set s where
     eta-equality
     inductive
diff --git a/src/Reflection/AST/Traversal.agda b/src/Reflection/AST/Traversal.agda
index 2598b75c1..913bc5b8f 100644
--- a/src/Reflection/AST/Traversal.agda
+++ b/src/Reflection/AST/Traversal.agda
@@ -27,7 +27,7 @@ open RawApplicative AppF
 -- compute the length of the context everytime it's needed.
 record Cxt : Set where
   constructor _,_
-  pattern
+  no-eta-equality; pattern
   field
     len     : ℕ
     context : List (String × Arg Term)
