-  infixr 2 step-≡ step-≡˘
+  infixr 2 step-≡˘
   step-≡ = step-≡-⟩
   {-# WARNING_ON_USAGE step-≡
   "Warning: step-≡ was deprecated in v2.0.
@@ -442,4 +442,3 @@ module end-syntax
 
