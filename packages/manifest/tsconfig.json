{
  // The manifests import the engine's path rules, and no platform.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/manifest.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/**/*.ts", "../engine/src/core/platform.d.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../engine/src/core" }]
}
