{
  "name": "@agda-native-ide/engine",
  "version": "0.1.0",
  "description": "The engine client: Agda's interaction protocol behind one interface, with a browser and a native transport.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser/worker": {
      "types": "./dist/browser/worker/als.d.ts",
      "default": "./dist/browser/worker/als.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "node": "./dist/native/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@runno/wasi": "^0.10.0",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "zod": "^4.3.6"
  }
}
