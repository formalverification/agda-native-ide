    "outDir": "../../dist/core",
    "tsBuildInfoFile": "../../dist/core.tsbuildinfo",
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["./**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
